# Google Maps API Key - Get your key from https://console.cloud.google.com/
# Must have Distance Matrix API and Maps SDK enabled
# DO NOT COMMIT THIS FILE - .env is in .gitignore
GOOGLE_MAPS_API_KEY=

# Secret key - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# DO NOT COMMIT THIS FILE - .env is in .gitignore
SECRET_KEY=

# CORS - Comma-separated list of allowed origins (production)
# For development, this will be overridden
CORS_ALLOWED_ORIGINS=https://myapp.com,https://www.myapp.com

# Server configuration
PORT=5000
FLASK_ENV=development
